[{"id":"2b79d94a","text":"Αθήνα"},
{"id":"c51ebb53","text":"βιβλίο"},
{"id":"ba5ffa1e","text":"γάλα"},
{"id":"bb849e8f","text":"δέκα"},
{"id":"85cdf793","text":"ζάχαρη"},
{"id":"3bb49f25","text":"ήλιος"},
{"id":"ce66e41a","text":"θάλασσα"},
{"id":"9a977799","text":"καφές"},
{"id":"3b84c186","text":"λεμόνι"},
{"id":"43e6e452","text":"νερό"},
{"id":"36322510","text":"ταξί"},
{"id":"fa0b3f2b","text":"όνομα"},
{"id":"acb6e5d8","text":"πατάτα"},
{"id":"70799ed5","text":"σπίτι"},
{"id":"396f7019","text":"τρένο"},
{"id":"d3bfbd16","text":"φίλος"},
{"id":"5f082c00","text":"χαρά"},
{"id":"43341fff","text":"ψωμί"},
{"id":"e45d1f7d","text":"ώρα"},
{"id":"c53b64bf","text":"μουσική"},
{"id":"3c39ca2a","text":"μπίρα"},
{"id":"4496303a","text":"ευχαριστώ"},
{"id":"1d87ae11","text":"άλφα. Αθήνα"},
{"id":"656170df","text":"βήτα. βιβλίο"},
{"id":"cb13b4bc","text":"γάμμα. γάλα"},
{"id":"50f1ed6f","text":"δέλτα. δέκα"},
{"id":"2dcb2dc2","text":"έψιλον. ευχαριστώ"},
{"id":"ac875f4b","text":"ζήτα. ζάχαρη"},
{"id":"e466827d","text":"ήτα. ήλιος"},
{"id":"4fe67dd4","text":"θήτα. θάλασσα"},
{"id":"3d47ea2e","text":"γιώτα. "},
{"id":"993873a7","text":"κάπα. καφές"},
{"id":"252ec6c8","text":"λάμδα. λεμόνι"},
{"id":"85286382","text":"μι. μουσική"},
{"id":"a19178b8","text":"νι. νερό"},
{"id":"d9f2594e","text":"ξι. "},
{"id":"9285c45f","text":"όμικρον. όνομα"},
{"id":"cf22eb64","text":"πι. πατάτα"},
{"id":"e09c443c","text":"ρο. "},
{"id":"1b36a91e","text":"σίγμα. σπίτι"},
{"id":"a240e9f0","text":"ταυ. ταξί"},
{"id":"db6785a8","text":"ύψιλον. "},
{"id":"47fe3710","text":"φι. φίλος"},
{"id":"b084b489","text":"χι. χαρά"},
{"id":"b12f995b","text":"ψι. ψωμί"},
{"id":"104cc06a","text":"ωμέγα. ώρα"},
{"id":"7e805cf8","text":"Γεια σου"},
{"id":"f9ec9f97","text":"Γεια σας"},
{"id":"b850442a","text":"Καλημέρα"},
{"id":"462626a5","text":"Καλησπέρα"},
{"id":"b57b3b79","text":"Καληνύχτα"},
{"id":"99b11232","text":"Αντίο"},
{"id":"ee4acd39","text":"Πώς σε λένε;"},
{"id":"6f7f37c0","text":"Πώς σας λένε;"},
{"id":"c3486f21","text":"Με λένε Άννα."},
{"id":"b9b65887","text":"Χαίρω πολύ."},
{"id":"cbec70b1","text":"Από πού είσαι;"},
{"id":"71adc9eb","text":"Από πού είστε;"},
{"id":"7ad397ed","text":"Είμαι από την Αγγλία."},
{"id":"5a4fd353","text":"Εσύ;"},
{"id":"4d1a3b41","text":"Καλημέρα! Με λένε Νίκο. Πώς σε λένε;"},
{"id":"6698eb80","text":"Γεια σου, Νίκο. Με λένε Σάρα."},
{"id":"794b4191","text":"Χαίρω πολύ. Από πού είσαι;"},
{"id":"b82e1a6d","text":"Είμαι από την Αγγλία. Εσύ;"},
{"id":"d117dca1","text":"Είμαι από την Κρήτη."},
{"id":"b2df7f6d","text":"Τι κάνεις;"},
{"id":"a5a79c9b","text":"Τι κάνετε;"},
{"id":"15dedea0","text":"Καλά, ευχαριστώ."},
{"id":"c7c86905","text":"Πολύ καλά."},
{"id":"a0136246","text":"Μια χαρά."},
{"id":"fc31eb09","text":"Έτσι κι έτσι."},
{"id":"68a079d1","text":"Όχι πολύ καλά."},
{"id":"2bc67779","text":"Από εδώ ο Γιάννης."},
{"id":"d1143222","text":"μηδέν"},
{"id":"9c89e15c","text":"ένα"},
{"id":"761fe69c","text":"δύο"},
{"id":"1a82dbc0","text":"τρία"},
{"id":"87982e9b","text":"τέσσερα"},
{"id":"3308bbcc","text":"πέντε"},
{"id":"ddb46af9","text":"έξι"},
{"id":"3dd2811c","text":"εφτά"},
{"id":"fa6e544e","text":"οχτώ"},
{"id":"06fd0e0b","text":"εννιά"},
{"id":"640dbb62","text":"Γεια σας, κυρία Ελένη. Τι κάνετε;"},
{"id":"78205a49","text":"Καλά, ευχαριστώ. Εσείς;"},
{"id":"d86b1b37","text":"Μια χαρά. Από εδώ η Μαρία, η φίλη μου."},
{"id":"a82f2a64","text":"Χαίρω πολύ, Μαρία."},
{"id":"fb6842c8","text":"Πού μένεις;"},
{"id":"1dbfc13d","text":"Μένω στην Αθήνα."},
{"id":"0f74a136","text":"Μένω στο Ηράκλειο."},
{"id":"be087789","text":"Δευτέρα"},
{"id":"e9f1ca40","text":"Τρίτη"},
{"id":"bee5553b","text":"Τετάρτη"},
{"id":"9ae39277","text":"Πέμπτη"},
{"id":"1019eb28","text":"Παρασκευή"},
{"id":"eab89e3d","text":"Σάββατο"},
{"id":"74ac9d55","text":"Κυριακή"},
{"id":"2895fe43","text":"πάντα"},
{"id":"3619115e","text":"συχνά"},
{"id":"74c68507","text":"μερικές φορές"},
{"id":"d40f5edb","text":"ποτέ"},
{"id":"6cf10632","text":"Δουλεύω από Δευτέρα μέχρι Παρασκευή."},
{"id":"5389f004","text":"Πού μένεις, Σάρα;"},
{"id":"3151b3d6","text":"Μένω στο Ηράκλειο. Εσύ;"},
{"id":"849db6c5","text":"Εγώ μένω στα Χανιά. Δουλεύεις το Σάββατο;"},
{"id":"5f7f723c","text":"Όχι, δεν δουλεύω ποτέ το Σάββατο!"},
{"id":"d1848e29","text":"Τι δουλειά κάνεις;"},
{"id":"a6d818a9","text":"Είμαι δάσκαλος."},
{"id":"19aa1094","text":"Είμαι δασκάλα."},
{"id":"cb3791b7","text":"γιατρός"},
{"id":"0de15822","text":"οδηγός"},
{"id":"b90c22f2","text":"μάγειρας"},
{"id":"e3fb2175","text":"σερβιτόρος"},
{"id":"8f4b2a4b","text":"φοιτητής, φοιτήτρια"},
{"id":"015ace9f","text":"Πού δουλεύεις;"},
{"id":"9ff417bf","text":"Δουλεύω σε ένα ξενοδοχείο."},
{"id":"76bfaa4c","text":"Είμαι παντρεμένος."},
{"id":"6b4df29e","text":"Είμαι ελεύθερη."},
{"id":"839f0c92","text":"Ποιο είναι το τηλέφωνό σου;"},
{"id":"250d8ffb","text":"Είμαι οδηγός. Δουλεύω σε μια εταιρεία. Εσύ;"},
{"id":"93460611","text":"Εγώ είμαι μάγειρας σε μια ταβέρνα."},
{"id":"ef13957c","text":"Ωραία! Είσαι παντρεμένος;"},
{"id":"b28f3ffc","text":"Όχι, είμαι ελεύθερος."},
{"id":"9b9395ab","text":"Μιλάς ελληνικά;"},
{"id":"d3c13fdf","text":"Μιλάω λίγο ελληνικά."},
{"id":"767a4c14","text":"αγγλικά"},
{"id":"474ef334","text":"Είμαι Άγγλος."},
{"id":"e4abad7d","text":"Είμαι Αγγλίδα."},
{"id":"c35de21a","text":"Έλληνας, Ελληνίδα"},
{"id":"64de62f7","text":"Δεν καταλαβαίνω."},
{"id":"35555af5","text":"Πιο σιγά, παρακαλώ."},
{"id":"ded203ed","text":"η οικογένεια"},
{"id":"24d1a628","text":"η μητέρα"},
{"id":"e1bb5cb6","text":"ο πατέρας"},
{"id":"3e885f2b","text":"ο γιος, η κόρη"},
{"id":"a4663a43","text":"ο αδερφός, η αδερφή"},
{"id":"3215a477","text":"Έχεις παιδιά;"},
{"id":"35d96256","text":"Έχω δύο παιδιά."},
{"id":"351f1d3f","text":"Ναι, λίγο. Είμαι Άγγλος, αλλά μένω στην Κρήτη."},
{"id":"1a2733d4","text":"Έχεις οικογένεια εδώ;"},
{"id":"2cdeae90","text":"Ναι, έχω δύο παιδιά."},
{"id":"6f8576b0","text":"Μπράβο! Μιλάς πολύ καλά."},
{"id":"4481924c","text":"Ένα νερό, παρακαλώ."},
{"id":"678232a5","text":"Πόσο κάνει;"},
{"id":"ce6987b5","text":"Κάνει δύο ευρώ."},
{"id":"9fbeb0bc","text":"Θα ήθελα έναν καφέ."},
{"id":"ce198212","text":"ένας φρέντο εσπρέσο"},
{"id":"b279f477","text":"σκέτο, μέτριο, γλυκό"},
{"id":"48fbbc82","text":"ένα ψωμί"},
{"id":"c684f025","text":"μια τυρόπιτα"},
{"id":"585ce9f3","text":"Κάτι άλλο;"},
{"id":"5da6e82f","text":"Όχι, ευχαριστώ."},
{"id":"63b5b7f9","text":"Ορίστε."},
{"id":"f97e0d88","text":"Τον λογαριασμό, παρακαλώ."},
{"id":"4db57ed0","text":"Καλημέρα! Τι θα πάρετε;"},
{"id":"09979d36","text":"Θα ήθελα έναν φρέντο εσπρέσο, μέτριο."},
{"id":"f3fdcb1d","text":"Και μια τυρόπιτα, παρακαλώ. Πόσο κάνει;"},
{"id":"5a833097","text":"Πέντε ευρώ."},
{"id":"75d7f373","text":"Ορίστε. Ευχαριστώ!"},
{"id":"76ec301b","text":"ψηλός, κοντός"},
{"id":"259f1a0a","text":"αδύνατος, χοντρός"},
{"id":"226ae7db","text":"νέος, ηλικιωμένος"},
{"id":"db66e3b4","text":"ωραίος, άσχημος"},
{"id":"73b3c113","text":"μεγάλος, μικρός"},
{"id":"39d3a531","text":"καινούργιος, παλιός"},
{"id":"09086e05","text":"ακριβός, φτηνός"},
{"id":"17525e02","text":"συμπαθητικός"},
{"id":"4ca694af","text":"Ποιος είναι αυτός;"},
{"id":"cdf7590c","text":"Ποια είναι αυτή;"},
{"id":"95c6abad","text":"ο φίλος μου που μένει στη Ρόδο"},
{"id":"ba7eee67","text":"χίλια"},
{"id":"73888e65","text":"δύο χιλιάδες"},
{"id":"19e17a32","text":"ένα εκατομμύριο"},
{"id":"4530fe01","text":"ήμουν"},
{"id":"461e4812","text":"θα είμαι"},
{"id":"f626c092","text":"Ποιος είναι ο Πέτρος;"},
{"id":"ffc124d7","text":"Είναι ο ψηλός με τα μαύρα μαλλιά."},
{"id":"a9dba598","text":"Είναι ο αδερφός σου;"},
{"id":"79d44476","text":"Όχι, είναι φίλος μου. Είναι πολύ συμπαθητικός."},
{"id":"b7cd5e04","text":"Χθες ήμουν στο σπίτι του. Είναι μεγάλο και ωραίο."},
{"id":"166057ea","text":"το ψυγείο"},
{"id":"8bb95edf","text":"το πλυντήριο"},
{"id":"4da54686","text":"η κουζίνα"},
{"id":"25b9ce27","text":"ο φούρνος μικροκυμάτων"},
{"id":"14a60523","text":"η τηλεόραση"},
{"id":"ad474daf","text":"το κλιματιστικό"},
{"id":"9afb81f3","text":"Ξυπνάω στις εφτά."},
{"id":"f6312900","text":"Πίνω καφέ."},
{"id":"731b6a00","text":"Τρώω πρωινό."},
{"id":"ba8632e0","text":"Πηγαίνω στη δουλειά."},
{"id":"d8b4d457","text":"Γυρίζω σπίτι το απόγευμα."},
{"id":"840c9289","text":"Κοιμάμαι στις έντεκα."},
{"id":"0f6e6db9","text":"συνήθως"},
{"id":"2abb6f77","text":"σπάνια"},
{"id":"55a8f909","text":"Τι έφαγες;"},
{"id":"5ca4e0d7","text":"Έφαγα σαλάτα."},
{"id":"a8739de4","text":"Καλησπέρα, θέλω ένα καινούργιο ψυγείο."},
{"id":"c121c64d","text":"Μάλιστα. Αυτό εδώ είναι πολύ καλό και δεν είναι ακριβό."},
{"id":"f0b62286","text":"Πεντακόσια ευρώ."},
{"id":"becc2a4a","text":"Εντάξει, το παίρνω."},
{"id":"f00d3a4e","text":"Τι ώρα είναι;"},
{"id":"b6c38887","text":"Είναι δύο."},
{"id":"940236ed","text":"Είναι τρεις και μισή."},
{"id":"ff33093f","text":"Είναι πέντε παρά τέταρτο."},
{"id":"f58cd3fa","text":"το λεωφορείο"},
{"id":"28aa1070","text":"το μετρό"},
{"id":"43822364","text":"το πλοίο"},
{"id":"730cb8b7","text":"Πάω στη δουλειά με το λεωφορείο."},
{"id":"cd1120b9","text":"Πού είναι η στάση;"},
{"id":"cf09c839","text":"Τι καιρό κάνει;"},
{"id":"e0ecc0bd","text":"Κάνει ζέστη."},
{"id":"c76c7149","text":"Κάνει κρύο."},
{"id":"01ecce38","text":"Βρέχει."},
{"id":"65f748b4","text":"Έχει ήλιο."},
{"id":"0df4708e","text":"το καλοκαίρι, ο χειμώνας"},
{"id":"fc25884f","text":"Συγγνώμη, τι ώρα είναι;"},
{"id":"40e418da","text":"Είναι οχτώ και μισή."},
{"id":"1dba3903","text":"Πού είναι η στάση για το λεωφορείο;"},
{"id":"0dfb6243","text":"Εκεί, δίπλα στο περίπτερο."},
{"id":"7cd6fe92","text":"Ευχαριστώ πολύ! Κάνει πολλή ζέστη σήμερα."},
{"id":"94a353a6","text":"Ναι, είναι καλοκαίρι!"},
{"id":"f472b8a5","text":"η λαϊκή"},
{"id":"8df3fb7f","text":"οι ντομάτες"},
{"id":"bd0f27a1","text":"οι πατάτες"},
{"id":"3212775d","text":"τα μήλα"},
{"id":"3cdc91f0","text":"τα πορτοκάλια"},
{"id":"ec88825f","text":"τα αγγούρια"},
{"id":"64c6a4d5","text":"ένα κιλό"},
{"id":"39889270","text":"μισό κιλό"},
{"id":"be1fe01b","text":"Πόσο κάνουν οι ντομάτες;"},
{"id":"bd93df95","text":"Δύο ευρώ το κιλό."},
{"id":"478a0d90","text":"το γάλα"},
{"id":"08de24b7","text":"το τυρί"},
{"id":"ea8df2a5","text":"τα αυγά"},
{"id":"0e0e7368","text":"Τι άλλο;"},
{"id":"2f838fca","text":"Τίποτα άλλο, ευχαριστώ."},
{"id":"bbb8e70c","text":"Ελάτε, φρέσκες ντομάτες!"},
{"id":"76f68f32","text":"Ενάμισι ευρώ το κιλό."},
{"id":"63a94401","text":"Θα ήθελα δύο κιλά, και μισό κιλό μήλα."},
{"id":"489b5213","text":"το πουκάμισο"},
{"id":"db7e1a9a","text":"το παντελόνι"},
{"id":"7fc92af0","text":"η φούστα"},
{"id":"9603471f","text":"το φόρεμα"},
{"id":"71906902","text":"η μπλούζα"},
{"id":"4c7d7bd3","text":"το μπουφάν"},
{"id":"a53bd95e","text":"τα παπούτσια"},
{"id":"f6ba8f0f","text":"Τι νούμερο φοράτε;"},
{"id":"c6c70ddd","text":"Μπορώ να το δοκιμάσω;"},
{"id":"2d0f0a60","text":"Μου αρέσει."},
{"id":"a6fd3106","text":"Μου πάει;"},
{"id":"1c7d1bcf","text":"Δεν μου κάνει."},
{"id":"24d800fe","text":"κόκκινο, μπλε, πράσινο"},
{"id":"57bf7ced","text":"μαύρο, άσπρο"},
{"id":"086051e8","text":"κίτρινο, γκρι"},
{"id":"15de93bd","text":"Μπορώ να σας βοηθήσω;"},
{"id":"9038cbd1","text":"Ναι, ψάχνω ένα πουκάμισο."},
{"id":"ddc69989","text":"Σαράντα δύο. Μπορώ να το δοκιμάσω;"},
{"id":"d7f1deec","text":"Βεβαίως. Τα δοκιμαστήρια είναι εκεί."},
{"id":"903c1758","text":"Μου κάνει και μου αρέσει. Το παίρνω!"},
{"id":"62bdeabe","text":"το διαμέρισμα"},
{"id":"567a367b","text":"η μονοκατοικία"},
{"id":"dac29dcd","text":"το υπνοδωμάτιο"},
{"id":"47a8b824","text":"το σαλόνι"},
{"id":"8a9875e7","text":"το μπάνιο"},
{"id":"8fb4705b","text":"το μπαλκόνι"},
{"id":"36b9d434","text":"ο πρώτος όροφος"},
{"id":"af736d79","text":"το ενοίκιο"},
{"id":"dbed4747","text":"Υπάρχει φαρμακείο εδώ κοντά;"},
{"id":"3120a0aa","text":"δίπλα στην τράπεζα"},
{"id":"49d07474","text":"απέναντι από το πάρκο"},
{"id":"ea39f7da","text":"Πήγαινε ευθεία."},
{"id":"24ff58a6","text":"Στρίψε δεξιά."},
{"id":"49bf3a58","text":"Στρίψε αριστερά."},
{"id":"9f37f8de","text":"Πότε θα έρθεις;"},
{"id":"365520f5","text":"Καλημέρα, τηλεφωνώ για το διαμέρισμα στην αγγελία."},
{"id":"f3d1d3da","text":"Ναι. Είναι στον τρίτο όροφο, έχει δύο υπνοδωμάτια και μεγάλο μπαλκόνι."},
{"id":"11880a88","text":"Υπάρχει σούπερ μάρκετ κοντά;"},
{"id":"a54e4c8b","text":"Ναι, απέναντι από την πολυκατοικία."},
{"id":"a796b0ff","text":"Πόσο είναι το ενοίκιο;"},
{"id":"80d0594e","text":"Τετρακόσια πενήντα ευρώ τον μήνα."},
{"id":"3d016f56","text":"Ένα τραπέζι για δύο, παρακαλώ."},
{"id":"419245e7","text":"Τον κατάλογο, παρακαλώ."},
{"id":"a3e2e3b2","text":"Τι θα πάρετε;"},
{"id":"ea7c2e15","text":"Θα πάρω μουσακά."},
{"id":"39385ef6","text":"η χωριάτικη σαλάτα"},
{"id":"a42fd17a","text":"το σουβλάκι"},
{"id":"da3854f7","text":"ο γύρος"},
{"id":"30829b58","text":"οι πατάτες τηγανητές"},
{"id":"e1180517","text":"το κρασί"},
{"id":"2c2c9c36","text":"Τι θα πιείτε;"},
{"id":"852a9ef0","text":"Ήταν πολύ νόστιμο!"},
{"id":"2cfbf88b","text":"Θα πληρώσω με κάρτα."},
{"id":"d16c3baf","text":"Θα παραγγείλω για το σπίτι."},
{"id":"146a210a","text":"αύριο"},
{"id":"4eec70ac","text":"Καλησπέρα! Είστε έτοιμοι να παραγγείλετε;"},
{"id":"f5abbaa7","text":"Ναι. Θα πάρουμε μια χωριάτικη σαλάτα και δύο σουβλάκια."},
{"id":"21141ae7","text":"Ένα μπουκάλι νερό και μισό κιλό κρασί."},
{"id":"1aff1546","text":"Αμέσως."},
{"id":"a4ec6f53","text":"Ήταν πολύ νόστιμα! Τον λογαριασμό, παρακαλώ."},
{"id":"f10700d2","text":"Έχω κράτηση."},
{"id":"5d20bc4c","text":"Θέλω να κλείσω ένα δωμάτιο."},
{"id":"f7727abf","text":"μονόκλινο, δίκλινο"},
{"id":"057a9c19","text":"για δύο νύχτες"},
{"id":"9aa71aab","text":"Είναι μαζί το πρωινό;"},
{"id":"cd0e4005","text":"το κλειδί"},
{"id":"832ae13c","text":"η ρεσεψιόν"},
{"id":"8814ca75","text":"το διαβατήριο"},
{"id":"4b1d27d7","text":"η βαλίτσα"},
{"id":"378d92a1","text":"το εισιτήριο"},
{"id":"a82e25f9","text":"το αεροδρόμιο"},
{"id":"d73b562b","text":"Τι ώρα φεύγει το πλοίο;"},
{"id":"9026da07","text":"Θα σε πάρω τηλέφωνο."},
{"id":"4cf4c409","text":"Το κλιματιστικό δεν δουλεύει."},
{"id":"a44057e2","text":"Καλησπέρα, πώς μπορώ να σας βοηθήσω;"},
{"id":"03d186e8","text":"Έχω κράτηση στο όνομα Τζόουνς."},
{"id":"bb94b508","text":"Μάλιστα, ένα δίκλινο για τρεις νύχτες. Το διαβατήριό σας, παρακαλώ;"},
{"id":"85e23608","text":"Ορίστε. Τι ώρα είναι το πρωινό;"},
{"id":"f5682d23","text":"Από τις εφτά μέχρι τις δέκα. Ορίστε το κλειδί σας."},
{"id":"ccd6c05a","text":"Θέλεις να πάμε σινεμά;"},
{"id":"88996f95","text":"Πάμε!"},
{"id":"6eb7a71b","text":"Δεν μπορώ, δυστυχώς."},
{"id":"623d4396","text":"η ταινία"},
{"id":"632dd761","text":"η συναυλία"},
{"id":"f5815431","text":"το θέατρο"},
{"id":"cbb7b7e3","text":"Τι ώρα αρχίζει;"},
{"id":"60598afb","text":"Μπορώ να καθίσω εδώ;"},
{"id":"57a30eeb","text":"Πρέπει να φύγω."},
{"id":"c796f9e5","text":"Μην αργήσεις!"},
{"id":"17903b1f","text":"Θέλω να έρθεις κι εσύ."},
{"id":"c612dc97","text":"Σου αρέσει η μουσική;"},
{"id":"7ce24e4e","text":"ελληνικός, ελληνική, ελληνικό"},
{"id":"6fa271ea","text":"Τα λέμε!"},
{"id":"4943b179","text":"Τι θα κάνεις το Σάββατο; Θέλεις να πάμε σινεμά;"},
{"id":"4f526c69","text":"Ναι, γιατί όχι; Τι ταινία παίζει;"},
{"id":"04969c2e","text":"Μια ελληνική κωμωδία. Αρχίζει στις εννιά."},
{"id":"397b2ce8","text":"Μπορώ να φέρω και την αδερφή μου;"},
{"id":"83e1663f","text":"Φυσικά! Μην αργήσετε!"},
{"id":"b4614327","text":"Πού πήγες διακοπές;"},
{"id":"60ce2c23","text":"Πήγα στη Νάξο."},
{"id":"c74b7b11","text":"χθες"},
{"id":"8b6857d4","text":"πέρσι"},
{"id":"0ee9cc6f","text":"την περασμένη εβδομάδα"},
{"id":"f1760691","text":"Κολύμπησα στη θάλασσα."},
{"id":"7808e604","text":"Έφαγα φρέσκο ψάρι."},
{"id":"206dc6ee","text":"Ήπια ένα ούζο."},
{"id":"ca46d46b","text":"Είδα το ηλιοβασίλεμα."},
{"id":"8f2bd75f","text":"Έκανα πολλές φωτογραφίες."},
{"id":"48195ceb","text":"Πώς ήταν;"},
{"id":"af9fbd2f","text":"Πέρασα τέλεια!"},
{"id":"6563838f","text":"Γύρισα την Κυριακή."},
{"id":"446621e4","text":"Πήγα στη Νάξο με την οικογένειά μου."},
{"id":"176c26a6","text":"Τι κάνατε εκεί;"},
{"id":"5c8a5f9a","text":"Κολυμπήσαμε κάθε μέρα και φάγαμε φρέσκο ψάρι."},
{"id":"1a4a5d7a","text":"Πώς ήταν ο καιρός;"},
{"id":"88a4de94","text":"Είχε ήλιο κάθε μέρα. Περάσαμε τέλεια!"},
{"id":"a2cf2c80","text":"η τράπεζα"},
{"id":"e80d94a8","text":"Θέλω να ανοίξω λογαριασμό."},
{"id":"00a29ade","text":"ο λογαριασμός"},
{"id":"f6ab1ca0","text":"η κατάθεση"},
{"id":"21eb2678","text":"η ανάληψη"},
{"id":"a2ad1da2","text":"η κάρτα"},
{"id":"ab0145c7","text":"ο κωδικός"},
{"id":"a60849d5","text":"το ταχυδρομείο"},
{"id":"c559c55b","text":"το γράμμα"},
{"id":"d162cd83","text":"το δέμα"},
{"id":"af5d134c","text":"συστημένο"},
{"id":"98513fee","text":"η διεύθυνση"},
{"id":"ce3b9fe0","text":"το κινητό"},
{"id":"bf4e8e09","text":"Μου δίνετε ένα πακέτο κινητής;"},
{"id":"c38f5ace","text":"Καλημέρα. Τι θα θέλατε;"},
{"id":"ca214deb","text":"Θέλω να στείλω αυτό το δέμα στην Αγγλία."},
{"id":"e428cb07","text":"Απλό ή συστημένο;"},
{"id":"f1bdab73","text":"Συστημένο, παρακαλώ. Πόσο κάνει;"},
{"id":"49a5d906","text":"Δεκαοχτώ ευρώ. Γράψτε εδώ τη διεύθυνση."},
{"id":"b066529f","text":"Δεν είμαι καλά."},
{"id":"815c214a","text":"Πονάει το κεφάλι μου."},
{"id":"c7f7968c","text":"Πονάει ο λαιμός μου."},
{"id":"ae104cf9","text":"Έχω πυρετό."},
{"id":"5518d3e3","text":"Είμαι κρυωμένος."},
{"id":"c9800384","text":"το φάρμακο"},
{"id":"b46fce28","text":"το νοσοκομείο"},
{"id":"1249fd63","text":"Θέλω να κλείσω ραντεβού."},
{"id":"46b48bdc","text":"Πάρτε ένα χάπι."},
{"id":"8e01eff6","text":"Μην ανησυχείτε."},
{"id":"c6599074","text":"Περαστικά!"},
{"id":"efac7c6c","text":"το χέρι, το πόδι"},
{"id":"48e28b30","text":"η πλάτη"},
{"id":"64c50224","text":"Βοήθεια!"},
{"id":"57ffa3cf","text":"Τι έχετε;"},
{"id":"d8db0a9d","text":"Δεν είμαι καλά. Πονάει ο λαιμός μου και έχω πυρετό."},
{"id":"bf775fb7","text":"Από πότε;"},
{"id":"165dccf2","text":"Από χθες."},
{"id":"8871c130","text":"Πίνετε πολλά υγρά, ξεκουραστείτε και μην ανησυχείτε."},
{"id":"f0df5583","text":"Ευχαριστώ, γιατρέ."},
{"id":"0449a0ad","text":"Χρόνια πολλά!"},
{"id":"bea56fd8","text":"Να τα εκατοστήσεις!"},
{"id":"34b8a267","text":"Καλά Χριστούγεννα!"},
{"id":"31cd11dd","text":"Καλή χρονιά!"},
{"id":"94ea8b20","text":"Καλό Πάσχα!"},
{"id":"87ddb642","text":"Χριστός Ανέστη! – Αληθώς Ανέστη!"},
{"id":"016bc842","text":"η ονομαστική γιορτή"},
{"id":"dc799c26","text":"τα γενέθλια"},
{"id":"0e4a03db","text":"το δώρο"},
{"id":"f46bf390","text":"Καλή επιτυχία!"},
{"id":"93c26069","text":"Συγχαρητήρια!"},
{"id":"160a91f1","text":"Καλό ταξίδι!"},
{"id":"baca025f","text":"Καλή όρεξη!"},
{"id":"657406e7","text":"Είμαι σαράντα χρονών."},
{"id":"1e8ed6f0","text":"το σπίτι της Μαρίας"},
{"id":"77bfab05","text":"Χρόνια πολλά, Γιώργο! Σήμερα γιορτάζεις!"},
{"id":"f690bd06","text":"Ευχαριστώ πολύ! Έλα το βράδυ στο σπίτι. Θα κάνουμε ένα μικρό πάρτι."},
{"id":"e484bc14","text":"Ωραία! Τι ώρα;"},
{"id":"50472807","text":"Στις εννιά. Αν θέλεις, φέρε και τη Ζωή."},
{"id":"09071d65","text":"Εντάξει. Να τα εκατοστήσεις!"},
{"id":"47791fde","text":"το σχολείο"},
{"id":"e2c10e4a","text":"το πανεπιστήμιο"},
{"id":"f17d5926","text":"Σπουδάζω οικονομικά."},
{"id":"f7c9f15d","text":"το πτυχίο"},
{"id":"c9fa7957","text":"ο μισθός"},
{"id":"e0d112e7","text":"το ωράριο"},
{"id":"2763fbea","text":"πλήρης, μερική απασχόληση"},
{"id":"2cfb8d50","text":"το βιογραφικό"},
{"id":"b2c8c848","text":"Κάνω αίτηση για μια δουλειά."},
{"id":"79ea82e4","text":"πιο μεγάλος από"},
{"id":"17126f6b","text":"καλύτερος"},
{"id":"93c90428","text":"ο καλύτερος"},
{"id":"914f8c89","text":"επειδή"},
{"id":"88098fd6","text":"για να"},
{"id":"4374c676","text":"αλλά"},
{"id":"f77c77cf","text":"αν και"},
{"id":"dac29bdd","text":"Τι θέλεις να κάνεις μετά το σχολείο;"},
{"id":"32aa8c92","text":"Θέλω να σπουδάσω στο πανεπιστήμιο για να γίνω μηχανικός."},
{"id":"b71f397b","text":"Γιατί μηχανικός;"},
{"id":"c13ddd0d","text":"Επειδή μου αρέσουν τα μαθηματικά. Εσύ;"},
{"id":"e2a530d5","text":"Εγώ βρήκα δουλειά σε ένα ξενοδοχείο. Ο μισθός δεν είναι πολύ καλός, αλλά το ωράριο είναι καλύτερο από πριν."}]
